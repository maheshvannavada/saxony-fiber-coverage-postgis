Setting up the project

-- The data comes in as EPSG:4326 (lat/lon degrees) from Geofabrik.
-- That's fine for display but useless for distance queries -- ST_DWithin
-- with a 500 metre threshold needs actual metres, not degrees.
-- UTM Zone 32N (EPSG:25832) covers Germany well, so reprojecting there.

ALTER TABLE buildings
  ALTER COLUMN geom TYPE geometry(Geometry, 25832)
  USING ST_Transform(geom, 25832);

ALTER TABLE roads
  ALTER COLUMN geom TYPE geometry(Geometry, 25832)
  USING ST_Transform(geom, 25832);

-- Rebuild indexes after reprojection -- old ones are stale now
CREATE INDEX idx_buildings_geom ON buildings USING GIST(geom);
CREATE INDEX idx_roads_geom ON roads USING GIST(geom);

