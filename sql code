Generating fiber nodes
-- No real fiber network data available for Saxony, so simulating one.
-- The idea: fiber cables typically run underground along major roads,
-- so interpolating points along primary/secondary/tertiary roads
-- gives a reasonable approximation of where nodes might be.
--
-- 0.20 step = one node every ~20% of each road segment.
-- Tried 0.02 first (4M nodes) -- way too heavy for the proximity joins.
-- 0.20 gives 478k nodes which is manageable and still dense enough.

CREATE TABLE generated_fiber_nodes AS
SELECT
    ROW_NUMBER() OVER () AS id,
    ST_LineInterpolatePoint(
        ST_LineMerge(geom),
        gs.frac
    ) AS geom
FROM roads,
     generate_series(0.0, 1.0, 0.20) AS gs(frac)
WHERE fclass IN (
    'primary', 'primary_link',
    'secondary', 'secondary_link',
    'tertiary', 'tertiary_link',
    'trunk', 'trunk_link'
);

-- 478,218 nodes generated across Saxony
CREATE INDEX idx_gen_fiber_geom
    ON generated_fiber_nodes USING GIST(geom);

