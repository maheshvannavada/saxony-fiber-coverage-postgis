Performace Optimization


-- Ran into a nasty slowdown early on. Original query used ::geography cast
-- inside ST_DWithin which looked reasonable but killed performance.
-- Took ~7 seconds on 1.79M buildings even with GIST indexes in place.
--
-- EXPLAIN ANALYZE showed "Parallel Seq Scan" -- indexes were being ignored.
-- Turns out PostgreSQL can't use a geometry GIST index when you cast to
-- geography inside the query. It falls back to sequential scan every time.

-- The slow version (don't use this):
-- SELECT COUNT(*) FROM buildings b
-- WHERE NOT EXISTS (
--     SELECT 1 FROM fiber_nodes f
--     WHERE ST_DWithin(b.geom::geography, f.geom::geography, 500)
-- );

-- Fix: reproject to EPSG:25832 (metres) so 500 already means 500 metres.
-- No geography cast needed, GIST index kicks in, query runs clean.

SELECT COUNT(*) FROM buildings b
WHERE NOT EXISTS (
    SELECT 1 FROM generated_fiber_nodes f
    WHERE ST_DWithin(b.geom, f.geom, 500)
);
-- Same result, dropped from ~7s to under 1s.

-- Also worth noting: selecting b.* in CREATE TABLE AS was slower than
-- just selecting b.id, b.geom -- made a noticeable difference at this scale.

-- Check indexes are being used after reprojection:
EXPLAIN ANALYZE
SELECT COUNT(*) FROM buildings b
WHERE NOT EXISTS (
    SELECT 1 FROM generated_fiber_nodes f
    WHERE ST_DWithin(b.geom, f.geom, 500)
);
-- Look for "Index Scan" or "Bitmap Index Scan" in output.
-- "Seq Scan" means something is wrong with the index setup.
